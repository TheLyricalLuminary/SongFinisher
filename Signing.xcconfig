// Code-signing identity for the iOS targets.
//
// This lives in an .xcconfig rather than in project.yml because the Xcode project is
// regenerated by `xcodegen generate`, which discards anything set through Xcode's
// Signing & Capabilities tab. Settings here survive regeneration, so signing is fixed
// once instead of every time the project is rebuilt.
//
// Set this to your own Team ID — Xcode → Settings → Accounts → your Apple ID, or the
// ten-character identifier at developer.apple.com → Membership. Leave it empty to let
// Xcode pick automatically, which is usually right when the Mac is signed into exactly
// one Apple ID.
DEVELOPMENT_TEAM = 473RT92HDB

// Automatic signing asks Apple for a profile matching the bundle IDs below. On a free
// (unenrolled) Apple ID this works, with one catch worth knowing: the profile it issues
// expires after **seven days**, after which the installed app stops launching and iOS
// shows "app is no longer available" over a greyed-out icon. Rebuilding from Xcode
// re-signs and restores it. Apple Developer Program enrollment raises that to a year and
// is required for TestFlight or the App Store regardless.
CODE_SIGN_STYLE = Automatic
